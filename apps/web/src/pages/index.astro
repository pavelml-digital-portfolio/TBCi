---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {Chart} from '../components/Charts';
import {Composition,Subscribe} from '../components/PublicWidgets';
import {Image} from 'astro:assets';
import terrain from '../assets/bg-03-faceted-terrain.png';
import art1 from '../assets/art-01-market-signal.png';
import art2 from '../assets/art-02-balanced-basket.png';
import art3 from '../assets/art-03-methodology.png';
import {articles} from '../data/articles';
const newsImages=[art1,art2,art3];
---
<Base><Header/><main>
<section class="hero" id="index"><Image src={terrain} alt="" class="hero-terrain" format="webp" quality={80} widths={[800,1600,1920]} sizes="100vw" loading="eager"/><div class="site-container hero-grid"><div class="hero-copy"><span class="eyebrow">КРИПТОВАЛЮТНЫЙ ИНДЕКС</span><h1>Структура рынка.<br/>Ясность данных.</h1><p>Следите за динамикой рынка. Изучайте состав корзины. Понимайте, как рассчитывается индекс.</p><div class="hero-actions"><a class="button button--primary" href="#composition">Изучить индекс <span aria-hidden="true">↗</span></a><a class="button button--outline" href="#methodology">Как это работает</a></div><div class="hero-caption"><span class="status-dot"></span>20 активов · единая методология</div></div><div class="hero-index panel"><div class="flex-between"><h2>TBCi <span>20</span></h2><span class="badge badge--subtle">Демо-данные</span></div><div class="index-number">96,28 <span>пункта</span><strong class="negative">−3,72%</strong></div><Chart client:visible compact/><div class="index-card-footer"><span>Изменение за выбранный период</span><span class="cyan">TBCi 20</span></div></div></div></section>
<section class="site-container landing-section" id="composition"><div class="section-heading"><div><span class="eyebrow">СТРУКТУРА ИНДЕКСА</span><h2>20 активов. Одна картина.</h2><p>TBCi 20 отражает структуру криптовалютного рынка в одном индексе.</p></div><span class="section-number" aria-hidden="true">01 /</span></div><Composition client:visible/></section>
<section class="site-container landing-section" id="methodology"><div class="section-heading"><div><span class="eyebrow">ПРОЗРАЧНЫЙ ПОДХОД</span><h2>Понятно, как всё устроено</h2><p>Динамика, состав и методология — без лишней сложности.</p></div><span class="section-number" aria-hidden="true">02 /</span></div><div class="feature-grid">{[{icon:'analytics',title:'Динамика рынка',text:'Индекс помогает увидеть общую картину за изменениями отдельных активов.'},{icon:'pie-chart',title:'Прозрачный состав',text:'Открытые доли активов и понятная история изменения корзины.'},{icon:'methodology',title:'Открытая методология',text:'Проверяемая формула и единый подход к расчёту показателя.'}].map(item=><article class="panel feature-card"><span class="icon" style={`mask-image:url(/icons/${item.icon}.svg)`} aria-hidden="true"></span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div><div class="panel formula-panel"><div><h3>Как рассчитывается индекс</h3><p>Капитализация активов корзины, приведённая к единому базовому значению.</p></div><div class="formula" aria-label="Индекс равен сумме цены, умноженной на предложение, делённой на делитель"><i>I</i> = <span class="fraction"><span>Σ (P × Q)</span><span>D</span></span></div><a class="text-button" href="/articles/index-methodology/">Изучить методологию <span aria-hidden="true">↗</span></a></div></section>
<section class="site-container landing-section" id="updates"><div class="section-heading"><div><span class="eyebrow">ЖУРНАЛ TBCi</span><h2>Обновления и аналитика</h2><p>О рынке, составе индекса и принципах работы сервиса.</p></div><a class="text-button" href="/articles/">Все публикации <span aria-hidden="true">↗</span></a></div><div class="news-grid">{articles.map((article,i)=><a class="panel news-card" href={`/articles/${article.slug}/`}><div class="news-image"><Image src={newsImages[i]} alt="" format="webp" quality={78} widths={[400,700]} sizes="(max-width:767px) 100vw, 33vw" loading="lazy"/><span class="news-category">{article.category}</span></div><div class="news-body"><span class="fine-print">Материал проекта</span><h3>{article.title}</h3><p>{article.description}</p><span class="news-arrow" aria-hidden="true">↗</span></div></a>)}</div></section>
<section class="site-container subscribe-section"><Subscribe client:visible/></section>
</main><Footer/></Base>

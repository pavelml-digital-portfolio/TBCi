---
import Base from '../../layouts/Base.astro';import Account from '../../components/Account';import {sectionTitles,type Section} from '../../data/demo';
export function getStaticPaths(){return ['wallets','indices','buy','compile','sell','unmake','history','holders','settings','help'].map(section=>({params:{section},props:{section:section as Section}}))}
const {section}=Astro.props;
---
<Base title={`${sectionTitles[section]} — TBCi`} privatePage><Account client:only="react" section={section}><div slot="fallback" class="loading-shell"><p>Загружаем кабинет…</p></div></Account></Base>

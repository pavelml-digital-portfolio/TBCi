---
import '../styles/global.css';
import { allIndices } from '../data/portfolio';
import { basket, news } from '../data/demo';
import { profiles } from '../data/market';
interface Props { title?:string; account?:boolean; description?:string; image?:string }
const {title='TBCi — Cryptocurrency indices',account=false}=Astro.props;
const path=Astro.url.pathname;
const segments=path.split('/').filter(Boolean);
const index=segments[0]==='index'?allIndices.find(i=>i.id===segments[1]):undefined;
const asset=segments[0]==='coins'?basket.find(a=>a.slug===segments[1]):undefined;
const article=segments[0]==='news'?news.find(a=>a.slug===segments[1]):undefined;
const titles:Record<string,string>={'/':'Cryptocurrency indices — TBCi','/app/':'Overview — TBCi','/app/wallets/':'Wallet — TBCi','/app/indices/':'Explore indices — TBCi','/app/strategy-lab/':'Index Strategy Lab — TBCi','/app/help/':'FAQ — TBCi','/app/history/':'Historical price — TBCi','/app/holders/':'Index holders — TBCi','/app/settings/':'Account settings — TBCi','/coins/':'Cryptocurrency markets — TBCi','/news/':'Market news and research — TBCi','/ico/':'ICO calendar — TBCi','/exchanges/':'Cryptocurrency exchanges — TBCi'};
const descriptions:Record<string,string>={'/':'Explore cryptocurrency indices and market research. A broader view of your assets.','/app/':'Track your purchased indices, combined exposure and portfolio analytics.','/app/wallets/':'Manage cryptocurrency and index assets, review balances and track deposits and withdrawals.','/app/indices/':'Compare seven cryptocurrency indices by price, risk and investment approach.','/app/strategy-lab/':'Compare index strategies with BTC, examine costs and drawdowns, and explore concentration, liquidity and stress scenarios.','/app/help/':'Answers about index trading, verification levels, fees, transfers and account security.','/app/history/':'Compare historical basket snapshots and index component prices.','/app/holders/':'Explore index holder distribution and ownership information.','/app/settings/':'Manage your profile, security, verification, preferences and account records.','/coins/':'Explore cryptocurrency prices, market capitalization and trading information.','/news/':'Read cryptocurrency market news, index analysis and research.','/ico/':'Explore token sale dates, project information and funding milestones.','/exchanges/':'Compare cryptocurrency exchanges, market activity and trading pairs.'};
const pageTitle=index?`${index.name} — TBCi`:asset?`${asset.name} (${asset.symbol}) — TBCi`:article?`${article.title} — TBCi`:titles[path]||title;
const description=Astro.props.description || (index?`${profiles[index.id]?.description} Explore component exposure, price information and strategy analysis.`:asset?`Explore ${asset.name} (${asset.symbol}) price information, market activity and historical performance.`:article?`${article.title}. Cryptocurrency market news and analysis from TBCi.`:descriptions[path]||`${pageTitle.replace(' — TBCi','')}: cryptocurrency market information, research and portfolio tools.`);
const url=new URL(path,Astro.site||'https://tbci.pavelml.ru').href;
const image=new URL(Astro.props.image|| (index?`/social/${index.id}.png`:asset?`/social/${asset.slug}.png`:article?`/social/${article.slug}.png`:titles[path]&&path!=='/'?`/social/${segments.join('-')}.png`:'/social/tbci.png'),Astro.site||'https://tbci.pavelml.ru').href;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#1d223b"/><meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex"/><meta name="description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:site_name" content="TBCi"/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={url}/><meta property="og:image" content={image}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={`${pageTitle} — A broader view of your assets.`}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/><link rel="icon" href="/favicon.svg"/><link rel="preload" href="/fonts/OpenSans-Regular.ttf" as="font" type="font/ttf" crossorigin/><link rel="canonical" href={url}/><title>{pageTitle}</title></head><body class={account?'account-page':'public-page'}><slot/></body></html>

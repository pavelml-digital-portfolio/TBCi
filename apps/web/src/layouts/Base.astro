---
import '../styles/global.css';
interface Props { title?:string; account?:boolean }
const {title='TBCi — Cryptocurrency index',account=false}=Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#1d223b"/><meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex"/><meta name="description" content="TBCi cryptocurrency index — composition, market information and a demonstration personal account."/><link rel="icon" href="/favicon.svg"/><link rel="preload" href="/fonts/OpenSans-Regular.ttf" as="font" type="font/ttf" crossorigin/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site).href}/><title>{title}</title></head><body class={account?'account-page':'public-page'}><slot/></body></html>
